# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret



# Email - production:
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-mailbox@example.com
MAIL_PASSWORD=your-mail-provider-app-password
MAIL_FROM=noreply@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# JWT (production)
JWT_SECRET=change-me-to-a-long-random-string

# Optional local seed data. Keep disabled outside disposable dev/test databases.
APP_SEED_ENABLED=false
APP_SEED_ADMIN_EMAIL=admin@shop.com
APP_SEED_ADMIN_PASSWORD=change-me-to-a-long-random-admin-password
